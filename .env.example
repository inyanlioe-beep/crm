# PostgreSQL connection string (app role - subject to RLS)
DATABASE_URL="postgresql://app_user:password@localhost:5432/crm"

# Admin/migration connection (bypasses RLS for migrations/seed). Optional; defaults to DATABASE_URL.
DATABASE_ADMIN_URL="postgresql://postgres:password@localhost:5432/crm"

# Session secret (min 32 chars) used to sign session tokens
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="CRM <noreply@example.com>"

# Billing (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""

# App
APP_URL="http://localhost:3000"

# Rate limiting (Upstash Redis - optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
